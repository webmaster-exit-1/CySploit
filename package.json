{
  "name": "cysploit",
  "version": "2.0.5",
  "description": "A cutting-edge cybersecurity platform designed to simplify network security assessment through advanced, interactive scanning and analysis tools.",
  "main": "electron/main.js",
  "scripts": {
    "dev": "npm run server",
    "dev:split": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "tsx --env-file .env server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc --project tsconfig.server.json",
    "check": "npm run lint",
    "lint": "eslint .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "preview": "npm run build && node dist/server/index.js",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5000 && npm run electron\"",
    "build:electron": "npm run build && electron-builder",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "ts-node scripts/migrate.ts",
    "db:push": "drizzle-kit push:pg"
  },
  "author": {
    "name": "webmaster-exit-1",
    "email": "echohellosuperuser@member.fsf.org"
  },
  "license": "ISC",
